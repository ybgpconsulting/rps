{
  "name": "royal-public-school",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-seo.mjs && tsc -b && tsc --noEmit -p tsconfig.worker.json && vite build",
    "lint": "oxlint src worker functions",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --experimental-strip-types --experimental-loader ./tests/ts-loader.mjs --test tests/*.test.mjs",
    "preview": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply rps --remote --env=\"\"",
    "db:migrate:preview": "wrangler d1 migrations apply royal-public-school-content-preview --remote --env preview",
    "db:migrate:local": "wrangler d1 migrations apply rps --local --env=\"\"",
    "deploy": "node scripts/clean-cf-build-output.mjs && npm run build && wrangler deploy --env=\"\" --keep-vars",
    "build:images": "node scripts/process-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "framer-motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
